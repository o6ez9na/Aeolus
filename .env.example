# Copy to .env before `docker compose up`.
# Generate the secret with: openssl rand -hex 32
AEOLUS_SECRET_KEY=
# Separate key for CA and client private keys at rest; rotating it makes every
# stored key unreadable and forces re-issuing certificates.
AEOLUS_PKI_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=aeolus
POSTGRES_DB=aeolus
PANEL_PORT=8080
AEOLUS_DEBUG=false

# Only used on first startup, while the users table is still empty.
AEOLUS_FIRST_ADMIN_USERNAME=admin
AEOLUS_FIRST_ADMIN_PASSWORD=
