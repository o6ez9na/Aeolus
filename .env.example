# Copy to .env before `docker compose up`.
# Generate the secret with: openssl rand -hex 32
AEOLUS_SECRET_KEY=
# Separate key for CA and client private keys at rest; rotating it makes every
# stored key unreadable and forces re-issuing certificates.
AEOLUS_PKI_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=aeolus
POSTGRES_DB=aeolus
PANEL_PORT=8080
AEOLUS_DEBUG=false

# Only used on first startup, while the users table is still empty.
AEOLUS_FIRST_ADMIN_USERNAME=admin
AEOLUS_FIRST_ADMIN_PASSWORD=

# --- panel ---
# Domain the panel answers on. Nodes dial it by name, and its certificate is
# issued for it, so it has to resolve here before the first start.
AEOLUS_DOMAIN=

# --- node (docker-compose.node.yml) ---
# Panel this node reports to.
AEOLUS_PANEL_DOMAIN=
# What the node calls itself in the join request; the panel may rename it.
AEOLUS_NODE_NAME=
# LANs behind this node, comma separated CIDRs. Empty = internet exit only.
AEOLUS_NODE_SUBNETS=
# Interface the node reaches the internet through, for NAT.
AEOLUS_NODE_WAN_IFACE=
