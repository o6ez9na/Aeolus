# Agents reach the panel's gRPC on 443 too. Their TLS hello names
# AEOLUS_GRPC_SNI (no DNS record behind it: the agent dials the panel's own
# address and only puts this name in the hello); layer4 hands such a
# connection to the backend still encrypted, so the backend checks the agent's
# certificate itself. Everything else falls through to the panel below.
{
	servers :443 {
		listener_wrappers {
			layer4 {
				@agents tls sni {$AEOLUS_GRPC_SNI:anemoi-grpc}
				route @agents {
					proxy backend:50051
				}
			}
			tls
		}
	}
}

{$AEOLUS_DOMAIN} {
	encode zstd gzip

	header {
		# The panel is HTTPS-only once a certificate exists; do not let a
		# downgraded request carry a session token in the clear.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	# The transit tunnel, disguised as an ordinary WebSocket on the panel's own
	# certificate. Some networks pass an OpenVPN handshake and then kill the flow
	# whatever port or protocol it uses; inside a real TLS session on 443 there
	# is nothing left to recognise.
	@transit path /transit /transit/*
	reverse_proxy @transit wstunnel:8080

	reverse_proxy frontend:80
}
