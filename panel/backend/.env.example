# Copy to .env and fill in. Generate the secret with: openssl rand -hex 32
AEOLUS_SECRET_KEY=change-me-openssl-rand-hex-32
AEOLUS_DATABASE_URL=postgresql+asyncpg://aeolus:aeolus@localhost:5432/aeolus
AEOLUS_DEBUG=false

AEOLUS_ACCESS_TOKEN_TTL_MINUTES=15
AEOLUS_REFRESH_TOKEN_TTL_DAYS=30

AEOLUS_CORS_ORIGINS=["http://localhost:5173"]

# Only used on first startup, while the users table is empty.
AEOLUS_FIRST_ADMIN_USERNAME=admin
AEOLUS_FIRST_ADMIN_PASSWORD=
